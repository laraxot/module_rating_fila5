# Cartelle di configurazione IDE: non stanno nella root di un modulo o di un tema.
# Sono impostazioni personali di chi sviluppa, non contratto del modulo, e su un
# repository condiviso fra basi diverse producono conflitti a ogni sync (XOT-5.38).
.cursor/
.devcontainer/
.windsurf/
/rector.php
/phpinsights.php
rector.php
graphify-out/

# Laraxot — forbidden at module/theme root (rector.php, phpinsights.php, .cursor, .windsurf, .vscode)
/.cursor
/.cursor/
/.windsurf
/.windsurf/
/.vscode
/.vscode/
.cursor~*
.windsurf~*
node_modules

